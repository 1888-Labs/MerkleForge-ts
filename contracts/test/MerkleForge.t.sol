pragma solidity ^0.8.24;

import {MerkleForgeBinary} from "../src/MerkleForgeBinary.sol";
import {MerkleForgeSparse} from "../src/MerkleForgeSparse.sol";
import {MerkleForgeVerifier} from "./Gas.t.sol";

/// Minimal Foundry cheatcode interface, so the tests need no forge-std submodule.
interface Vm {
    function readFile(string calldata path) external view returns (string memory);
    function parseJsonUint(string calldata json, string calldata key)
        external
        pure
        returns (uint256);
    function parseJsonBool(string calldata json, string calldata key) external pure returns (bool);
    function parseJsonBytes(string calldata json, string calldata key)
        external
        pure
        returns (bytes memory);
    function parseJsonBytes32(string calldata json, string calldata key)
        external
        pure
        returns (bytes32);
    function parseJsonBytes32Array(string calldata json, string calldata key)
        external
        pure
        returns (bytes32[] memory);
    function parseJsonUintArray(string calldata json, string calldata key)
        external
        pure
        returns (uint256[] memory);
    function parseJsonBytesArray(string calldata json, string calldata key)
        external
        pure
        returns (bytes[] memory);
    function toString(uint256 value) external pure returns (string memory);
}

/// Checks the Solidity verifiers against proofs generated by the TypeScript packages
/// (`pnpm fixtures:solidity` writes test/fixtures/proofs.json).
contract MerkleForgeTest {
    Vm private constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    string private json;

    function setUp() public {
        json = vm.readFile("test/fixtures/proofs.json");
    }

    function _at(string memory list, uint256 i, string memory field)
        private
        pure
        returns (string memory)
    {
        return string.concat(".", list, "[", vm.toString(i), "].", field);
    }

    function _flip(bytes32[] memory hashes) private pure returns (bytes32[] memory out) {
        out = new bytes32[](hashes.length);
        for (uint256 i; i < hashes.length; ++i) {
            out[i] = hashes[i];
        }
        if (out.length > 0) out[0] ^= bytes32(uint256(1));
    }

    function testConstants() public pure {
        require(MerkleForgeSparse.EMPTY_LEAF == keccak256(hex"00"), "empty leaf");
        require(MerkleForgeBinary.hashLeaf(hex"") == MerkleForgeSparse.EMPTY_LEAF, "hashLeaf");
    }

    function testBinaryProofs() public view {
        uint256 count = vm.parseJsonUint(json, ".binaryCount");
        require(count > 0, "no fixtures");
        for (uint256 i; i < count; ++i) {
            bytes32 root = vm.parseJsonBytes32(json, _at("binary", i, "root"));
            bytes memory leaf = vm.parseJsonBytes(json, _at("binary", i, "leaf"));
            uint256 index = vm.parseJsonUint(json, _at("binary", i, "leafIndex"));
            uint256 n = vm.parseJsonUint(json, _at("binary", i, "leafCount"));
            bytes32[] memory siblings = vm.parseJsonBytes32Array(json, _at("binary", i, "siblings"));

            require(
                MerkleForgeBinary.verify(root, leaf, index, n, siblings), "valid proof rejected"
            );
            require(
                !MerkleForgeBinary.verify(root, bytes.concat(leaf, "x"), index, n, siblings),
                "forged leaf"
            );
            require(
                !MerkleForgeBinary.verify(root, leaf, index ^ 1, n, siblings) || n == 1,
                "wrong index"
            );
            require(
                !MerkleForgeBinary.verify(root, leaf, index, n * 2 + 1, siblings), "wrong count"
            );
            if (siblings.length > 0) {
                require(
                    !MerkleForgeBinary.verify(root, leaf, index, n, _flip(siblings)),
                    "tampered sibling"
                );
            }
            require(!MerkleForgeBinary.verify(root, leaf, n, n, siblings), "index out of range");
            require(!MerkleForgeBinary.verify(root, "", index, n, siblings), "empty leaf");
        }
    }

    function testBinaryMultiProofs() public view {
        uint256 count = vm.parseJsonUint(json, ".multiCount");
        for (uint256 i; i < count; ++i) {
            bytes32 root = vm.parseJsonBytes32(json, _at("multi", i, "root"));
            bytes[] memory leaves = vm.parseJsonBytesArray(json, _at("multi", i, "leaves"));
            uint256[] memory indices = vm.parseJsonUintArray(json, _at("multi", i, "leafIndices"));
            uint256 n = vm.parseJsonUint(json, _at("multi", i, "leafCount"));
            bytes32[] memory hashes = vm.parseJsonBytes32Array(json, _at("multi", i, "hashes"));

            require(
                MerkleForgeBinary.verifyMultiProof(root, leaves, indices, n, hashes),
                "valid multiproof"
            );
            if (hashes.length > 0) {
                require(
                    !MerkleForgeBinary.verifyMultiProof(root, leaves, indices, n, _flip(hashes)),
                    "tampered"
                );
            }
            leaves[0] = bytes.concat(leaves[0], "x");
            require(
                !MerkleForgeBinary.verifyMultiProof(root, leaves, indices, n, hashes), "forged leaf"
            );
        }
    }

    function testSparseProofs() public view {
        uint256 count = vm.parseJsonUint(json, ".sparseCount");
        for (uint256 i; i < count; ++i) {
            bytes32 root = vm.parseJsonBytes32(json, _at("sparse", i, "root"));
            bytes32 key = vm.parseJsonBytes32(json, _at("sparse", i, "key"));
            bool member = vm.parseJsonBool(json, _at("sparse", i, "member"));
            bytes32[] memory siblings = vm.parseJsonBytes32Array(json, _at("sparse", i, "siblings"));
            uint256 bitmap = uint256(vm.parseJsonBytes32(json, _at("sparse", i, "bitmap")));

            if (member) {
                bytes memory leaf = vm.parseJsonBytes(json, _at("sparse", i, "leaf"));
                require(
                    MerkleForgeSparse.verifyMembership(root, key, leaf, siblings, bitmap), "member"
                );
                require(
                    !MerkleForgeSparse.verifyNonMembership(root, key, siblings, bitmap),
                    "not absent"
                );
                require(
                    !MerkleForgeSparse.verifyMembership(
                        root, key, bytes.concat(leaf, "x"), siblings, bitmap
                    ),
                    "forged"
                );
                require(
                    !MerkleForgeSparse.verifyMembership(
                        root, key ^ bytes32(uint256(1)), leaf, siblings, bitmap
                    ),
                    "key"
                );
            } else {
                require(
                    MerkleForgeSparse.verifyNonMembership(root, key, siblings, bitmap), "non-member"
                );
                require(
                    !MerkleForgeSparse.verifyMembership(root, key, "x", siblings, bitmap),
                    "not present"
                );
            }
            if (siblings.length > 0) {
                require(
                    !MerkleForgeSparse.verifyNonMembership(root, key, _flip(siblings), bitmap)
                        || member,
                    "tampered"
                );
                require(
                    !MerkleForgeSparse.verifyMembership(root, key, "x", _flip(siblings), bitmap),
                    "tampered member"
                );
                require(
                    !MerkleForgeSparse.verifyNonMembership(
                        root, key, siblings, bitmap ^ (1 << 255)
                    ),
                    "bitmap"
                );
                require(
                    !MerkleForgeSparse.verifyMembership(root, key, "x", siblings, bitmap ^ 1),
                    "bitmap member"
                );
            }
        }
    }

    /// Calls through `MerkleForgeVerifier` so `forge test --gas-report` prices one verification.
    function testGasReport() public {
        MerkleForgeVerifier verifier = new MerkleForgeVerifier();
        uint256 last = vm.parseJsonUint(json, ".binaryCount") - 1;
        require(
            verifier.verifyBinary(
                vm.parseJsonBytes32(json, _at("binary", last, "root")),
                vm.parseJsonBytes(json, _at("binary", last, "leaf")),
                vm.parseJsonUint(json, _at("binary", last, "leafIndex")),
                vm.parseJsonUint(json, _at("binary", last, "leafCount")),
                vm.parseJsonBytes32Array(json, _at("binary", last, "siblings"))
            ),
            "binary"
        );
        require(
            verifier.verifySparse(
                vm.parseJsonBytes32(json, _at("sparse", 0, "root")),
                vm.parseJsonBytes32(json, _at("sparse", 0, "key")),
                vm.parseJsonBytes(json, _at("sparse", 0, "leaf")),
                vm.parseJsonBytes32Array(json, _at("sparse", 0, "siblings")),
                uint256(vm.parseJsonBytes32(json, _at("sparse", 0, "bitmap")))
            ),
            "sparse"
        );
    }
}
