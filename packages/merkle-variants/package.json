  },
  "bugs": "https://github.com/1888-Labs/MerkleForge-ts/issues",
  "keywords": [
    "merkleforge",
    "merkle",
    "merkle-tree",
    "merkletree",
    "merkle-proof",
    "merkle-root",
    "typescript",
    "cryptography",
    "authenticated-data-structures",
    "blockchain",
    "web3",
    "binary-merkle-tree",
    "sparse-merkle-tree",
